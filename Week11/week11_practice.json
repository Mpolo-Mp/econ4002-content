      "topic": "Welfare Theorems",
      "difficulty": "intermediate",
      "question": "State and apply the two fundamental welfare theorems.",
      "solution": {
        "a": {
          "first_theorem": "Every competitive equilibrium is Pareto efficient—no reallocation can make someone better off without making someone worse off."
        },
        "b": {
          "conditions": [
            "Perfect competition (price-taking behavior)",
            "No externalities (all costs/benefits internalized)",
            "Complete markets (all goods can be traded)",
            "Perfect information",
            "No transaction costs"
          ]
        },
        "c": {
          "second_theorem": "Any Pareto efficient allocation can be achieved as a competitive equilibrium, given appropriate redistribution of initial endowments."
        },
        "d": {
          "analysis": {
            "outcome_A": "CS=1000, PS=100, W=1100",
            "outcome_B": "CS=550, PS=550, W=1100",
            "efficiency": "Both are Pareto efficient (same total W)",
            "equity": "B may be preferred for more equal distribution"
          }
        },
        "e": {
          "political_palatability": "Efficient policies may harm concentrated interest groups (e.g., producers) while benefiting diffuse groups (e.g., consumers). Losers lobby harder than winners, making efficiency-enhancing reforms politically difficult."
        }
      }
    },
    {
      "id": "W11-P10",
      "type": "application",
      "topic": "Agricultural Price Support",
      "difficulty": "advanced",
      "question": "Wheat: Qᵈ = 100 - 2p, Qˢ = 3p - 50. Price floor pᶠ = 35 with government purchase.",
      "solution": {
        "a": {
          "equilibrium": "100 - 2p = 3p - 50 → 150 = 5p → p* = 30",
          "quantity": "Q* = 100 - 60 = 40"
        },
        "b": {
          "CS": "½(50 - 30)(40) = ½ × 20 × 40 = 400",
          "PS": "½(30 - 16.67)(40) = ½ × 13.33 × 40 = 266.67",
          "note": "Supply intercept: Qˢ = 0 when p = 50/3 ≈ 16.67",
          "W": "400 + 266.67 = 666.67"
        },
        "c": {
          "at_pf_35": {
            "Qᵈ": "100 - 70 = 30",
            "Qˢ": "105 - 50 = 55",
            "surplus": "55 - 30 = 25 units"
          }
        },
        "d": {
          "gov_expenditure": "35 × 25 = $875"
        },
        "e": {
          "new_CS": "½(50 - 35)(30) = ½ × 15 × 30 = 225",
          "new_PS": "Producers sell all 55 at $35",
          "PS_calc": "35 × 55 - ∫₀⁵⁵ Pˢ(Q)dQ",
          "PS_integration": "35(55) - [16.67(55) + ½(1/3)(55)²] = 1925 - [917 + 504] = 504",
          "gov_cost": "-875 (subtracted from welfare)",
          "net_W": "225 + 504 - 875 = -146"
        },
        "f": {
          "welfare_change": "New W - Old W = -146 - 666.67 ≈ -812.67",
          "note": "Large welfare loss from price support + government purchases"
        }
      }
    },
    {
      "id": "W11-P11",
      "type": "application",
      "topic": "Comparing Welfare Measures",
      "difficulty": "advanced",
      "question": "U = x^0.5 y^0.5, m = 200, pᵧ = 1. Price falls: pₓ = 4 → pₓ = 1. Compare CV, ΔCS, EV.",
      "solution": {
        "a": {
          "expectation": "Large price change (75% reduction) → significant difference between CV, ΔCS, EV",
          "reason": "Income effect becomes large, Marshallian and Hicksian demands diverge"
        },
        "b": {
          "initial": {
            "x⁰": "0.5 × 200 / 4 = 25",
            "y⁰": "0.5 × 200 / 1 = 100",
            "u⁰": "√(25 × 100) = 50"
          },
          "final": {
            "x¹": "0.5 × 200 / 1 = 100",
            "y¹": "0.5 × 200 / 1 = 100",
            "u¹": "√(100 × 100) = 100"
          }
        },
        "c": {
          "expenditure_function": "e(pₓ, pᵧ, u) = 2u√(pₓpᵧ)",
          "CV": "e(1, 1, 50) - 200 = 100 - 200 = -100",
          "EV": "e(4, 1, 100) - 200 = 400 - 200 = 200",
          "CS": "∫₁⁴ (100/pₓ) dpₓ = 100[ln4 - ln1] = 100 × 1.386 = 138.6"
        },
        "d": {
          "recommendation": "CV is preferred for cost-benefit analysis",
          "reason": "CV measures willingness to pay, which is relevant for whether consumers would accept/reject policy. It's also more conservative (smaller)."
        }
      }
    },
    {
      "id": "W11-P12",
      "type": "computational",
      "topic": "R Implementation",
      "difficulty": "intermediate",
      "question": "Write R functions for welfare calculations. Test with Pᵈ = 10 - Q, Pˢ = 2 + Q, ceiling pᶜ = 4.",
      "solution": {
        "r_code": [
          "# (a) Calculate CS and PS",
          "welfare_calc <- function(a, b, c, d) {",
          "  # Inverse demand: P = a - bQ, Inverse supply: P = c + dQ",
          "  Q_star <- (a - c) / (b + d)",
          "  p_star <- a - b * Q_star",
          "  ",
          "  CS <- 0.5 * (a - p_star) * Q_star",
          "  PS <- 0.5 * (p_star - c) * Q_star",
          "  ",
          "  list(Q = Q_star, p = p_star, CS = CS, PS = PS, W = CS + PS)",
          "}",
          "",
          "# (b) Price ceiling analysis",
          "ceiling_analysis <- function(a, b, c, d, p_ceil) {",
          "  base <- welfare_calc(a, b, c, d)",
          "  ",
          "  Q_s <- (p_ceil - c) / d",
          "  Q_d <- (a - p_ceil) / b",
          "  Q_traded <- min(Q_s, Q_d)",
          "  ",
          "  # Welfare at ceiling (using Q_traded)",
          "  P_d_at_Q <- a - b * Q_traded",
          "  CS_new <- 0.5 * (a - P_d_at_Q) * Q_traded + (P_d_at_Q - p_ceil) * Q_traded",
          "  PS_new <- 0.5 * (p_ceil - c) * Q_traded",
          "  W_new <- CS_new + PS_new",
          "  ",
          "  list(Q_traded = Q_traded, shortage = Q_d - Q_s,",
          "       CS = CS_new, PS = PS_new, W = W_new,",
          "       DWL = base$W - W_new)",
          "}",
          "",
          "# (c) CV and EV for Cobb-Douglas",
          "cv_ev_cd <- function(p1_old, p1_new, p2, m, alpha = 0.5) {",
          "  # Utility at old and new prices",
          "  x1_old <- alpha * m / p1_old",
          "  x2_old <- (1-alpha) * m / p2",
          "  u_old <- x1_old^alpha * x2_old^(1-alpha)",
          "  ",
          "  x1_new <- alpha * m / p1_new",
          "  x2_new <- (1-alpha) * m / p2",
          "  u_new <- x1_new^alpha * x2_new^(1-alpha)",
          "  ",
          "  # Expenditure function: e = u / k * p1^α * p2^(1-α)",
          "  k <- alpha^alpha * (1-alpha)^(1-alpha)",
          "  e_fn <- function(p1, p2, u) u / k * p1^alpha * p2^(1-alpha)",
          "  ",
          "  CV <- e_fn(p1_new, p2, u_old) - m",
          "  EV <- e_fn(p1_old, p2, u_new) - m",
          "  CS <- alpha * m * log(p1_old / p1_new)",
          "  ",
          "  list(CV = CV, EV = EV, CS = CS)",
          "}",
          "",
          "# Test",
          "welfare_calc(10, 1, 2, 1)",
          "ceiling_analysis(10, 1, 2, 1, 4)",
          "cv_ev_cd(10, 5, 5, 100, 0.5)"
        ],
        "test_results": {
          "welfare": "Q* = 4, p* = 6, CS = 8, PS = 8, W = 16",
          "ceiling": "Q_traded = 2, shortage = 4, CS = 10, PS = 2, W = 12, DWL = 4",
          "cv_ev": "CV ≈ -29.3, EV ≈ 41.4, CS ≈ 34.7"
        }
      }
    }
